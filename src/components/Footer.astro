---
import { Icon } from "astro-icon/components";
import lucasMDGif from "../assets/LucasMD.gif";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <a href="https://lucasmd.dev" class="md-link" aria-label="lucasmd.dev">
        <img src={lucasMDGif.src} alt="Lucas MD" class="md-gif" />
      </a>
      <span class="footer-meta eyebrow">
        Made with ♥ &amp; ☕ · © {currentYear} Lucas Dunker
      </span>
    </div>

    <nav class="socials" aria-label="Social links">
      <a href="https://www.linkedin.com/in/lucasdunker/" aria-label="LinkedIn">
        <Icon name="linkedin" class="ico" />
      </a>
      <a href="https://github.com/Lucas-Dunker" aria-label="GitHub">
        <Icon name="github" class="ico" />
      </a>
      <a href="mailto:lucasmd.dev@gmail.com" aria-label="Email">
        <Icon name="email" class="ico" />
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2.5rem 1.5rem;
  }
  .footer-inner {
    max-width: 62rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .md-gif {
    width: 5rem;
    height: 2rem;
    object-fit: contain;
  }
  .footer-meta {
    line-height: 1.4;
  }
  .socials {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .socials a {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
  }
  .socials a:hover {
    background: var(--paper-soft);
  }
  .socials a:active {
    transform: scale(0.94);
  }
  .ico {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
